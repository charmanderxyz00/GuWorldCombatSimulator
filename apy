import streamlit as st 
import random

st.title("Gu Master Duel Simulator")

if 'battle_started' not in st.session_state:
    st.session_state.battle_started = False
if 'turn' not in st.session_state:
    st.session_state.turn = 1
if 'log' not in st.session_state:
    st.session_state.log = []

max_cap_map = {1: 2, 2: 4, 3: 6, 4: 8, 5: 10}

class GuMaster:
    def __init__(self, name, rank, aptitude, gu_counts):
        self.name = name
        self.rank = rank
        self.aptitude = aptitude
        self.gu_counts = gu_counts
        
        hp_map = {1: 200, 2: 400, 3: 600, 4: 800, 5: 1000}
        self.max_hp = hp_map.get(rank, 200)
        self.hp = self.max_hp
        self.essence = 100.0
        
        thought_map = {1: 1, 2: 2, 3: 4, 4: 5, 5: 6}
        self.max_thoughts = thought_map.get(rank, 1)
        self.thoughts = self.max_thoughts
        
        self.agility_active = False
        self.active_defense = 0
        self.queued_actions = []
        self.turn_gu_uses = {}

    def reset_turn(self):
        regen_rate = 25.0 if self.aptitude == "Extreme" else 12.0
        self.essence = min(100.0, self.essence + regen_rate)
        
        thought_regen_map = {1: 1, 2: 2, 3: 2, 4: 2, 5: 3}
        regen_thoughts = thought_regen_map.get(self.rank, 1)
        self.thoughts = min(self.max_thoughts, self.thoughts + regen_thoughts)
        
        self.agility_active = False
        self.active_defense = 0
        self.queued_actions = []
        self.turn_gu_uses = {}

if not st.session_state.battle_started:
    st.subheader("Configure Setup")
    
    col1, col2 = st.columns(2)
    with col1:
        st.markdown("### Player Setup")
        p_name = st.text_input("Your Name", "Gu Master A")
        p_rank = st.slider("Your Rank", 1, 5, 3)
        p_apt = st.selectbox("Aptitude", ["Extreme", "A-Grade", "B-Grade", "C-Grade", "D-Grade"], index=0)
        p_cap = max_cap_map.get(p_rank, 2)
        
        st.markdown(f"**Gu Inventory (Cap: {p_cap})**")
        p_att = st.slider("Attack Gu", 0, 10, 2, key="p_att")
        p_def = st.slider("Defense Gu", 0, 10, 1, key="p_def")
        p_heal = st.slider("Healing Gu", 0, 10, 1, key="p_heal")
        p_agi = st.slider("Agility Gu", 0, 10, 2, key="p_agi")
        p_total = p_att + p_def + p_heal + p_agi

    with col2:
        st.markdown("### AI Setup")
        ai_name = st.text_input("AI Name", "Gu Master B")
        ai_rank = st.slider("AI Rank", 1, 5, 3)
        ai_apt = st.selectbox("AI Aptitude", ["Extreme", "A-Grade", "B-Grade", "C-Grade", "D-Grade"], index=1)
        ai_cap = max_cap_map.get(ai_rank, 2)
        
        st.markdown(f"**AI Gu Inventory (Cap: {ai_cap})**")
        ai_att = st.slider("AI Attack Gu", 0, 10, 2, key="ai_att")
        ai_def = st.slider("AI Defense Gu", 0, 10, 1, key="ai_def")
        ai_heal = st.slider("AI Healing Gu", 0, 10, 1, key="ai_heal")
        ai_agi = st.slider("AI Agility Gu", 0, 10, 2, key="ai_agi")
        ai_total = ai_att + ai_def + ai_heal + ai_agi

    if p_total > p_cap or ai_total > ai_cap:
        st.error("Allocation exceeds rank limit!")
    else:
        if st.button("Start Battle", type="primary"):
            st.session_state.player = GuMaster(p_name, p_rank, p_apt, {"Attack Gu": p_att, "Defense Gu": p_def, "Healing Gu": p_heal, "Agility Gu": p_agi})
            st.session_state.ai = GuMaster(ai_name, ai_rank, ai_apt, {"Attack Gu": ai_att, "Defense Gu": ai_def, "Healing Gu": ai_heal, "Agility Gu": ai_agi})
            st.session_state.battle_started = True
            st.session_state.turn = 1
            st.session_state.log = ["=== BATTLE COMMENCES ==="]
            st.rerun()

else:
    player = st.session_state.player
    ai = st.session_state.ai
    
    col_p, col_ai = st.columns(2)
    with col_p:
        st.markdown(f"### {player.name}")
        st.write(f"**HP:** {player.hp}/{player.max_hp}")
        st.write(f"**Essence:** {player.essence:.1f}% | **Thoughts:** {player.thoughts}/{player.max_thoughts}")
    with col_ai:
        st.markdown(f"### {ai.name}")
        st.write(f"**HP:** {ai.hp}/{ai.max_hp}")
        st.write(f"**Essence:** {ai.essence:.1f}% | **Thoughts:** {ai.thoughts}/{ai.max_thoughts}")

    st.markdown("---")
    st.subheader(f"Turn {st.session_state.turn} - Action Queue")
    
    if player.hp > 0 and ai.hp > 0 and st.session_state.turn <= 15:
        action_choice = st.selectbox("Choose Action to Queue:", [
            ('Attack Gu (10% Essence, 1 Thought, 20 DMG/rank)', 'attack'),
            ('Active Defense Gu (15% Essence, 1 Thought, 30 Shield/rank)', 'defense'),
            ('Healing Gu (15% Essence, 1 Thought, 20 HP/rank)', 'heal'),
            ('Agility Gu (5% Essence, 1 Thought, Speed Priority)', 'agility'),
        ], format_func=lambda x: x[0])
        
        col_btn1, col_btn2 = st.columns(2)
        with col_btn1:
            if st.button("Queue Action"):
                if player.thoughts <= 0:
                    st.warning("No thoughts remaining this turn! Click Submit Turn.")
                else:
                    choice_key = action_choice[1]
                    gu_name_map = {'attack': 'Attack Gu', 'defense': 'Defense Gu', 'heal': 'Healing Gu', 'agility': 'Agility Gu'}
                    cost_map = {'attack': 10.0, 'defense': 15.0, 'heal': 15.0, 'agility': 5.0}
                    
                    target_gu = gu_name_map[choice_key]
                    max_owned = player.gu_counts.get(target_gu, 0)
                    used = player.turn_gu_uses.get(target_gu, 0)
                    
                    if used >= max_owned:
                        st.warning(f"You've queued all available copies of {target_gu}!")
                    elif player.essence < cost_map[choice_key]:
                        st.warning("Not enough essence!")
                    else:
                        player.thoughts -= 1
                        player.essence -= cost_map[choice_key]
                        player.turn_gu_uses[target_gu] = used + 1
                        player.queued_actions.append(choice_key)
                        st.success(f"Queued: {target_gu}")
                        st.rerun()

        with col_btn2:
            if st.button("Submit Turn (Lock In)", type="primary"):
                ai_usage = {}
                cost_map = {'attack': 10.0, 'defense': 15.0, 'heal': 15.0, 'agility': 5.0}
                name_to_key = {'Attack Gu': 'attack', 'Defense Gu': 'defense', 'Healing Gu': 'heal', 'Agility Gu': 'agility'}
                
                while ai.thoughts > 0:
                    hp_pct = ai.hp / ai.max_hp
                    action_chosen = None
                    if hp_pct < 0.5 and ai.essence >= cost_map['heal'] and ai_usage.get('Healing Gu', 0) < ai.gu_counts.get('Healing Gu', 0):
                        action_chosen = 'heal'
                    elif not ai.agility_active and ai.essence >= cost_map['agility'] and ai_usage.get('Agility Gu', 0) < ai.gu_counts.get('Agility Gu', 0):
                        action_chosen = 'agility'
                        ai.agility_active = True
                    elif ai.essence >= cost_map['attack'] and ai_usage.get('Attack Gu', 0) < ai.gu_counts.get('Attack Gu', 0):
                        action_chosen = 'attack'
                    elif ai.essence >= cost_map['defense'] and ai_usage.get('Defense Gu', 0) < ai.gu_counts.get('Defense Gu', 0):
                        action_chosen = 'defense'
                    else:
                        action_chosen = 'pass'
                    
                    ai.thoughts -= 1
                    if action_chosen != 'pass':
                        for g_name, g_key in name_to_key.items():
                            if g_key == action_chosen:
                                ai_usage[g_name] = ai_usage.get(g_name, 0) + 1
                        ai.essence -= cost_map[action_chosen]
                        ai.queued_actions.append(action_chosen)
                    else:
                        ai.queued_actions.append('pass')

                p_has_ag = 'agility' in player.queued_actions
                ai_has_ag = 'agility' in ai.queued_actions
                if p_has_ag and not ai_has_ag:
                    first, second = player, ai
                elif ai_has_ag and not p_has_ag:
                    first, second = ai, player
                else:
                    first, second = (player, ai) if random.choice([True, False]) else (ai, player)

                def resolve_turn(actor, target):
                    shield, heal, dmg, abs_val = 0, 0, 0, 0
                    for action in actor.queued_actions:
                        if actor.hp <= 0 or target.hp <= 0:
                            break
                        if action == 'defense':
                            s_val = 30 * actor.rank
                            actor.active_defense += s_val
                            shield += s_val
                        elif action == 'heal':
                            h_val = min(20 * actor.rank, actor.max_hp - actor.hp)
                            actor.hp += h_val
                            heal += h_val
                        elif action == 'agility':
                            actor.agility_active = True
                        elif action == 'attack':
                            raw = 20 * actor.rank
                            if target.active_defense > 0:
                                absorbed = min(target.active_defense, raw)
                                target.active_defense -= absorbed
                                abs_val += absorbed
                                net = raw - absorbed
                                if net > 0:
                                    target.hp -= net
                                    dmg += net
                            else:
                                target.hp -= raw
                                dmg += raw
                    return shield, heal, dmg, abs_val

                f_shield, f_heal, f_dmg, f_abs = resolve_turn(first, second)
                s_shield, s_heal, s_dmg, s_abs = resolve_turn(second, first)
                
                st.session_state.log.insert(1, f"Turn {st.session_state.turn}: {first.name} acted first. {first.name} dealt {f_dmg} DMG | {second.name} dealt {s_dmg} DMG.")
                
                st.session_state.turn += 1
                player.reset_turn()
                ai.reset_turn()
                st.rerun()

    st.markdown("### Battle Log")
    for entry in st.session_state.log:
        st.text(entry)

    if player.hp <= 0 or ai.hp <= 0 or st.session_state.turn > 15:
        st.subheader("=== BATTLE OVER ===")
        if player.hp <= 0:
            st.error("Defeat! AI wins.")
        elif ai.hp <= 0:
            st.success("Victory! You win.")
        if st.button("Reset Game"):
            st.session_state.battle_started = False
            st.rerun()